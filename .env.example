# ---------------------------------------------------------------------------
# IME Service — variabili d'ambiente
# Copia questo file in `.env` e adatta i valori.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Sviluppo: SQLite su file, nessun servizio esterno da avviare.
DATABASE_URL="file:./dev.db"
#
# Produzione: basta puntare a Postgres e cambiare `provider` in
# prisma/schema.prisma da "sqlite" a "postgresql".
# DATABASE_URL="postgresql://utente:password@host:5432/ime_service?schema=public"

# --- Area riservata --------------------------------------------------------
# Credenziali del redattore. In produzione usare una password lunga e casuale.
ADMIN_EMAIL="redazione@ime-service.it"
ADMIN_PASSWORD="cambiami-subito"
# Segreto per firmare il cookie di sessione (min. 32 caratteri).
# Generane uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="sviluppo-locale-segreto-da-sostituire-in-produzione"

# --- Upload allegati -------------------------------------------------------
# `local`  = filesystem del server (default, cartella ./storage/uploads)
# `s3`     = bucket S3-compatibile (richiede le variabili S3_* qui sotto)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""

# --- Invio email -----------------------------------------------------------
# `console` = stampa il messaggio nei log (default in sviluppo)
# `smtp`    = server SMTP classico (richiede le variabili SMTP_*)
# `resend`  = API Resend (richiede RESEND_API_KEY)
MAIL_DRIVER="console"
MAIL_FROM="Sito IME Service <no-reply@ime-service.it>"
MAIL_TO="info@ime-service.it"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# RESEND_API_KEY=""

# --- SEO / metadati --------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

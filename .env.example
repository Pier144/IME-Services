# ---------------------------------------------------------------------------
# IME Service — variabili d'ambiente
# Copia questo file in `.env` e riempi i valori.
# `.env` è escluso da git: le credenziali non vanno mai committate.
# ---------------------------------------------------------------------------

# --- Database (Supabase · progetto IME-Services · eu-west-1) ----------------
# Le trovi in: Supabase → Project Settings → Database → Connection string.
# Attenzione a non scambiarle, fanno due lavori diversi:
#
#   DATABASE_URL → "Transaction pooler" (porta 6543). La usa l'applicazione.
#                  Su serverless ogni istanza aprirebbe connessioni proprie:
#                  senza pooler il database esaurisce i posti disponibili.
#   DIRECT_URL   → "Session pooler" (porta 5432). La usano le migrazioni, che
#                  hanno bisogno di una sessione vera per prendere i lock.
#                  Si usa il session pooler e non la connessione diretta perché
#                  quest'ultima su Supabase è raggiungibile solo via IPv6.
#
DATABASE_URL="postgresql://postgres.inaafiqegjoehzmusyda:LA_TUA_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.inaafiqegjoehzmusyda:LA_TUA_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# --- Area riservata --------------------------------------------------------
ADMIN_EMAIL="redazione@ime-service.it"
ADMIN_PASSWORD="cambiami-subito"
# Segreto per firmare il cookie di sessione (min. 32 caratteri).
# Generane uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="sviluppo-locale-segreto-da-sostituire-in-produzione"

# --- Allegati --------------------------------------------------------------
# `local` = filesystem (solo sviluppo: su Vercel il disco è di sola lettura)
# `s3`    = bucket S3-compatibile — con Supabase Storage è questo
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"

# Supabase Storage. Il bucket `allegati` **esiste già** ed è privato (limite 20 MB,
# come l'allegato più grande ammesso dai form): nessun file esce con un indirizzo
# pubblico, si passa sempre da /api/media che controlla i permessi e poi rimanda a
# un link firmato che scade dopo cinque minuti.
# Restano da generare solo le due chiavi, in: Supabase → Storage → S3 Access Keys.
# In produzione STORAGE_DRIVER va messo a "s3": su Vercel il disco è di sola lettura
# e con il driver locale ogni caricamento fallisce.
# S3_ENDPOINT="https://inaafiqegjoehzmusyda.supabase.co/storage/v1/s3"
# S3_REGION="eu-west-1"
# S3_BUCKET="allegati"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Invio email -----------------------------------------------------------
# `console` = stampa il messaggio nei log (default in sviluppo)
# `smtp`    = server SMTP aziendale
# `resend`  = API Resend
MAIL_DRIVER="console"
MAIL_FROM="Sito IME Service <no-reply@ime-service.it>"
MAIL_TO="imeservicesrls@gmail.com"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# RESEND_API_KEY=""

# --- SEO / metadati --------------------------------------------------------
# In produzione: https://www.ime-service.it
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

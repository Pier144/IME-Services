# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# database (SQLite locale — in produzione si usa Postgres)
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*

# file caricati dagli utenti in sviluppo (storage locale)
/storage/uploads/*
!/storage/uploads/.gitkeep

# env
.env
.env*.local

# impostazioni locali degli agenti: possono contenere segreti (NEON_API_KEY)
/.claude/settings.local.json

# misc
.DS_Store
*.pem
/coverage
.vercel
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editor
.idea
.vscode/*
!.vscode/extensions.json

# skill degli agenti: le fonti stanno in .agents/ e si committano,
# i collegamenti sotto .claude/skills/ sono symlink a percorsi assoluti
# di questa macchina e vanno rigenerati con `npx skills add`
/.claude/skills/

# Foto dei prototipi di design: sono copie byte per byte di public/foto/,
# servono solo perche' i .dc.html si aprano nel browser. Per ricrearle:
#   cp public/foto/*.jpg design/handoff-admin/foto/
/design/handoff-admin/foto/

# Cartella di consegna dell'handoff: i file sono gia' in design/handoff-admin/
/Ricreazione pagina admin/
